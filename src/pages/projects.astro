---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const projects = [
  {
    title: 'Two-Wheeled Self-Balancing Robot (Patented)',
    desc: 'Self-balancing robot built in three rounds: ideation, proof of concept, and finale.',
    tech: 'C++',
    url: 'https://github.com/Viraj216/Patented_Two-Wheeled-Self-Balancing-Robot',
  },
  {
    title: 'PNM HBM Pointer Chasing',
    desc: 'Processing-near-memory study of pointer-chasing workloads on HBM.',
    tech: 'Python',
    url: 'https://github.com/Viraj216/pnm-hbm-pointer-chasing',
  },
  {
    title: 'RISC-V Core with Floating-Point and Vector Operations',
    desc: 'RISC-V core extended with floating-point and vector instructions.',
    tech: 'Tcl',
    url: 'https://github.com/Viraj216/RISC-V-Core-with-Floating-Point-and-Vector-Operations',
  },
  {
    title: 'RISC-V32I on FPGA',
    desc: 'RV32I implementation running on an FPGA.',
    tech: 'C',
    url: 'https://github.com/Viraj216/RISC-V32I-On-FPGA',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Projects | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
    <style>
      .grid { display: grid; gap: 1.5rem; }
      .card { border: 1px solid #ccc; border-radius: 12px; padding: 1.25rem; }
      .card h3 { margin: 0 0 0.5rem; }
      .tech { font-size: 0.85rem; opacity: 0.7; }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>Projects</h1>
      <div class="grid">
        {projects.map((p) => (
          <div class="card">
            <h3><a href={p.url} target="_blank" rel="noopener">{p.title}</a></h3>
            <p>{p.desc}</p>
            <span class="tech">{p.tech}</span>
          </div>
        ))}
      </div>
    </main>
    <Footer />
  </body>
</html>
